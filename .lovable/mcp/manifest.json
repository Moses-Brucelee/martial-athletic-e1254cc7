{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://kbiuojepvucbsadesbcf.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "martial-athletic-gateway",
      "version": "0.1.0",
      "title": "Martial Athletic Gateway"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in user's Martial Athletic athlete profile.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_competitions",
        "title": "List competitions",
        "description": "List competitions visible to the signed-in user, optionally filtered by status or a name search.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "published",
                "live",
                "completed",
                "expired"
              ],
              "description": "Filter by competition status."
            },
            "search": {
              "type": "string",
              "minLength": 1,
              "description": "Case-insensitive match on the competition name."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum competitions to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_competition",
        "title": "Get competition details",
        "description": "Return one competition with its divisions and visible workouts, as the signed-in user is allowed to see them.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "competition_id": {
              "type": "string",
              "format": "uuid",
              "description": "The competition UUID."
            }
          },
          "required": [
            "competition_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_my_registrations",
        "title": "List my registrations",
        "description": "List competition registrations belonging to the signed-in user (as athlete or registrant).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "competition_id": {
              "type": "string",
              "format": "uuid",
              "description": "Restrict to a single competition."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 25,
              "description": "Maximum registrations to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_leaderboard",
        "title": "Get competition leaderboard",
        "description": "Return the current leaderboard standings for a competition, grouped by division.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "competition_id": {
              "type": "string",
              "format": "uuid",
              "description": "The competition UUID."
            },
            "division_id": {
              "type": "string",
              "format": "uuid",
              "description": "Only return standings for this division."
            }
          },
          "required": [
            "competition_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_programs",
        "title": "List training programs",
        "description": "List training programs the signed-in user can access (their own plus public published programs).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "Filter by program category."
            },
            "level": {
              "type": "string",
              "minLength": 1,
              "description": "Filter by difficulty level."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "description": "Maximum programs to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
